# Copy to .env and adjust. Every setting uses the AEGIS_ prefix.

# "mock" runs fully offline. "groq" needs a free API key from https://console.groq.com/keys
AEGIS_PROVIDER=mock
AEGIS_GROQ_API_KEY=
# Pick a model listed at https://console.groq.com/docs/models
AEGIS_DEFAULT_MODEL=llama-3.1-8b-instant

AEGIS_APPS_FILE=config/apps.example.yaml

# PII guard: "mask" pseudonymizes personal data before it leaves the gateway, "off" disables it.
AEGIS_PII_MODE=mask
# Secret for the keyed PII tokens (min. 32 characters, required in production).
# Generate one with: aegis-secret
AEGIS_PII_SECRET=
# Pseudonym style: "tag" (<IBAN_55e8a87c>) or "format" (valid-looking IBAN via FF1 encryption)
AEGIS_PII_PSEUDONYM_STYLE=tag
# Optional: restrict to some entity types, e.g. ["EMAIL_ADDRESS","IBAN"]. Empty = all.
# AEGIS_PII_ENTITIES=[]
# Optional NER for free-standing names and places (needs the "ner" extra).
AEGIS_PII_NER_ENABLED=false
AEGIS_LOG_LEVEL=INFO
AEGIS_ENVIRONMENT=development

# JSON list of browser origins allowed to call the gateway (the dashboard, later).
# AEGIS_CORS_ORIGINS=["http://localhost:5173"]
